/arm/[i-k]*,CONFIG_ARM_TOOLCHAIN_GNU_EABI

# Boards build by CMake
CMake,sabre-6quad:smp
CMake,sabre-6quad:coredump
CMake,sabre-6quad:nsh

-sabre-6quad:citest

# SOF_TIMESTAMPING_SOFTWARE redefined
-imxrt1064-evk:canfd
-imxrt1064-evk:can
-teensy-4.x:can-4.1
-teensy-4.x:pikron-bb
-imxrt1060-evk:canfd
-imxrt1060-evk:can
-imxrt1170-evk:canfd
-imxrt1170-evk:can

# error: missing argument to '-Wstack-usage='
-sabre-6quad:libcxx

# Defconfig selects CONFIG_ARM_TOOLCHAIN_BUILDROOT_OABI (arm-nuttx-elf-gcc);
# no such prebuilt in the OpenVela manifest and the vela plugin does not
# apply the testlist's GNU_EABI toolchain override (known limitation).
-Linux,twr-k60n512:nsh
-Linux,kwikstik-k40:ostest
